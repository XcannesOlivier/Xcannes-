# ========================================
# XCANNES FRONTEND - VARIABLES REQUISES
# ========================================

# Runtime stage (development | staging | production)
NEXT_PUBLIC_ENVIRONMENT=development

# Backend endpoints (HTTP & WebSocket)
NEXT_PUBLIC_XCANNES_API_URL=http://localhost:3001
NEXT_PUBLIC_XCANNES_WS_URL=ws://localhost:3002

# URL interne (server-side) vers moonpay-service
MOONPAY_SERVICE_URL=http://localhost:3010

# Wallet destination (XRPL address)
NEXT_PUBLIC_DESTINATION_WALLET=

# Public site URLs
NEXT_PUBLIC_SITE_URL=http://localhost:2500
NEXT_PUBLIC_RETURN_URL_WEB=http://localhost:2500

# Google reCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# OVH SMTP credentials
OVH_EMAIL_PASSWORD=
