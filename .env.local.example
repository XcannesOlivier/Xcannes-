# ========================================
# XCANNES FRONTEND - VARIABLES REQUISES
# ========================================
#
# ⚠️  Toutes les valeurs marquées CHANGEME_xxx DOIVENT être
#     remplacées avant le démarrage.
#

# Runtime stage (development | staging | production)
NEXT_PUBLIC_ENVIRONMENT=development

# ── Backend endpoints (HTTP & WebSocket) ──────────────────
NEXT_PUBLIC_XCANNES_API_URL=http://localhost:3001
NEXT_PUBLIC_XCANNES_WS_URL=ws://localhost:3002

# URL interne (server-side) vers moonpay-service
MOONPAY_SERVICE_URL=http://localhost:3010

# ── RLUSD / XRPL ─────────────────────────────────────────
NEXT_PUBLIC_RLUSD_ISSUER=rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De

# ── Wallet addresses XRPL ────────────────────────────────
# Adresse spread (reçoit les frais FX)
NEXT_PUBLIC_XCANNES_SPREAD_WALLET_ADDRESS=rGt44i8APV6KMLCCkuaJpY19RVkj2JhnHC
# Adresse activation (si différente de spread)
NEXT_PUBLIC_XCANNES_ACTIVATION_WALLET_ADDRESS=rGt44i8APV6KMLCCkuaJpY19RVkj2JhnHC

# ── MoonPay destination tags ─────────────────────────────
# Chaque devise a son propre destination tag pour identifier
# les achats via MoonPay dans les transactions XRPL
NEXT_PUBLIC_MOONPAY_TAG_RLUSD=590
NEXT_PUBLIC_MOONPAY_TAG_XRP=589
# Feature flags (Phase 0)
MOONPAY_UI_ENABLED=true
MOONPAY_STATEMENT_TAG_FALLBACK=false
MOONPAY_SELL_STATUS_ENABLED=false
# Adresses MoonPay sell (séparées par des virgules)
NEXT_PUBLIC_MOONPAY_WALLETS=

# ── Public site URLs ─────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:2500
NEXT_PUBLIC_RETURN_URL_WEB=http://localhost:2500

# ── Google reCAPTCHA ─────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=CHANGEME_recaptcha_site_xxx   # ⚠️ CHANGE THIS!
RECAPTCHA_SECRET=CHANGEME_recaptcha_secret_xxx               # ⚠️ CHANGE THIS!

# ── OVH SMTP credentials ────────────────────────────────
OVH_EMAIL_PASSWORD=CHANGEME_ovh_xxx                          # ⚠️ CHANGE THIS!

# ── SimpleSwap (API partner) ─────────────────────────────
# ⚠️ IMPORTANT : garder la clé côté serveur (pas de NEXT_PUBLIC_)
SIMPLESWAP_API_KEY=CHANGEME_simpleswap_api_key_xxx            # ⚠️ CHANGE THIS!
# (Optionnel) base URL si SimpleSwap change de version
SIMPLESWAP_API_BASE_URL=https://api.simpleswap.io/v3
# (Optionnel) identification RLUSD côté SimpleSwap
SIMPLESWAP_RLUSD_TICKER=rlusd
SIMPLESWAP_RLUSD_NETWORK=xrp
# (Optionnel mais recommandé) Destination tag à forcer quand RLUSD est la devise de réception (XRPL)
# Permet d’associer le swap aux statements côté XCANNES sans exposer le tag côté client.
SIMPLESWAP_TAG_RLUSD=591
